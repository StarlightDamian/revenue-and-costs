NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://revenue_costs_app@127.0.0.1:5433/revenue_and_costs
DATABASE_CAPACITY_PATH=D:\path\to\postgres-data
TEST_DATABASE_URL=postgresql://revenue_costs_test@127.0.0.1:5433/revenue_and_costs_test
PUBLIC_ORIGIN=http://127.0.0.1:5173
OTP_HMAC_KEY=replace-with-at-least-32-bytes
SESSION_HMAC_KEY=replace-with-at-least-32-bytes
PAYMENT_PROVIDER=sandbox
SMS_PROVIDER=sandbox
# 仅供 development/test；生产环境配置固定验证码或注册管理员手机号会失败闭合。
SANDBOX_OTP_CODE=246810
REGISTRATION_ADMIN_PHONE=
CHINAMONEY_ENABLED=false
# 开发环境留空时使用中国货币网官方 Excel；配置 JSON HTTP 源时必须包含 {from}、{to}、{page}、{pageSize}；生产只允许官方 HTTPS 主机。
CHINAMONEY_ENDPOINT_TEMPLATE=
# 仅记录已审批的接入/授权编号，不在此处保存密钥或 Cookie。
CHINAMONEY_AUTHORIZATION_REFERENCE=
# 仅供 development/test，生产配置该项会失败闭合。
CHINAMONEY_FIXTURE_PATH=
CHINAMONEY_HISTORY_START=2006-01-04
STORAGE_ROOT=.work/storage/local
STORAGE_REPLICA_ROOT=.work/storage/replica
STORAGE_POLICY=LOCAL_VERIFIED
FILE_KEK_BASE64=replace-with-32-byte-base64-key
REMOTE_BACKUP_TARGET=
