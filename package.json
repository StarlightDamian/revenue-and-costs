{
  "name": "revenue-and-costs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "brace-expansion@<2.0.0": "1.1.18",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
      "brace-expansion@>=4.0.0 <6.0.0": "5.0.9",
      "fast-uri@>=3.0.0 <4.0.0": "3.1.5",
      "fast-uri@>=4.0.0 <5.0.0": "4.1.2",
      "nanoid@>=3.0.0 <4.0.0": "3.3.17",
      "uuid@<11.1.1": "11.1.1"
    }
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9.15 <10"
  },
  "scripts": {
    "dev:web": "vite",
    "dev:api": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "start:api": "node dist/server/api/index.js",
    "start:worker": "node dist/server/worker/index.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/db-status.ts",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "db:bootstrap-mappings": "tsx scripts/bootstrap-mappings.ts",
    "db:assert-production-initial-state": "tsx scripts/assert-production-initial-state.ts",
    "fx:sync": "node dist/cli/sync-fx.js",
    "test": "vitest run --exclude \"tests/integration/**\"",
    "test:watch": "vitest",
    "test:postgres": "vitest run tests/integration --exclude \"tests/integration/operations-recovery-runtime.test.ts\" --exclude \"tests/integration/report-acceptance-postgres.test.ts\"",
    "test:report-acceptance": "vitest run tests/integration/report-acceptance-postgres.test.ts",
    "test:recovery": "vitest run tests/integration/operations-recovery-runtime.test.ts",
    "test:ui-contract": "playwright test",
    "test:e2e": "pnpm test:ui-contract",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit",
    "build:web": "vite build",
    "build:server": "tsup src/api/index.ts src/worker/index.ts --format esm --sourcemap --out-dir dist/server --clean",
    "build:cli": "tsup scripts/migrate.ts scripts/db-status.ts scripts/bootstrap-admin.ts scripts/bootstrap-mappings.ts scripts/assert-production-initial-state.ts scripts/sync-fx.ts scripts/replay-shop-sources.ts scripts/resume-source-replay.ts --format esm --sourcemap --out-dir dist/cli --clean",
    "build": "pnpm typecheck && pnpm build:web && pnpm build:server && pnpm build:cli",
    "verify": "pnpm test && pnpm lint && pnpm typecheck && pnpm build",
    "verify:release": "pnpm verify && pnpm test:postgres && pnpm test:ui-contract"
  },
  "dependencies": {
    "@aws-crypto/client-node": "5.0.2",
    "@aws-crypto/sha256-js": "5.2.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@js-temporal/polyfill": "0.5.1",
    "@sinclair/typebox": "0.34.52",
    "@tus/server": "2.4.2",
    "archiver": "8.0.0",
    "csv-parse": "7.0.1",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "fastify": "5.10.0",
    "pg": "8.22.0",
    "pg-boss": "12.26.3",
    "pg-copy-streams": "7.0.0",
    "vue": "3.5.40",
    "vue-router": "5.2.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.0",
    "@types/archiver": "8.0.0",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-vue": "6.0.8",
    "esbuild": "0.28.1",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.10.0",
    "tsup": "8.5.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.8"
  }
}
