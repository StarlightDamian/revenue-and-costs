[Unit]
Description=Revenue and Costs API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=revenue-costs
Group=revenue-costs
WorkingDirectory=/opt/revenue-and-costs
Environment=NODE_ENV=production
EnvironmentFile=/etc/revenue-costs/revenue-costs.env
ExecStart=/usr/bin/node dist/server/api/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/revenue-costs
UMask=0077

[Install]
WantedBy=multi-user.target
