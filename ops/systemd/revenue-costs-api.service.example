[Unit]
Description=Revenue and Costs API
After=network-online.target postgresql-17.service
Wants=network-online.target

[Service]
Type=simple
User=revenue-costs
Group=revenue-costs
WorkingDirectory=/opt/revenue-costs/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/revenue-and-costs/database-app.env
EnvironmentFile=/etc/revenue-and-costs/revenue-costs.env
ExecStart=/opt/revenue-costs/node/bin/node /opt/revenue-costs/current/dist/server/api/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/revenue-costs
UMask=0077

[Install]
WantedBy=multi-user.target
