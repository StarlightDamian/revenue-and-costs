limit_req_zone $binary_remote_addr zone=revenue_costs_api:10m rate=20r/s;

server {
    listen 443 ssl http2;
    server_name revenue-costs.example.invalid;

    ssl_certificate /etc/letsencrypt/live/revenue-costs.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/revenue-costs.example.invalid/privkey.pem;

    root /opt/revenue-and-costs/dist/web;
    index index.html;
    client_max_body_size 20m;

    location /api/ {
        limit_req zone=revenue_costs_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 75s;
        proxy_request_buffering off;
    }

    location /health/ {
        proxy_pass http://127.0.0.1:3000;
        access_log off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
