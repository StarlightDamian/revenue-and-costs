limit_req_zone $binary_remote_addr zone=revenue_costs_api:10m rate=20r/s;

server {
    listen 443 ssl http2;
    server_name www.googcci.com.cn;

    ssl_certificate /etc/letsencrypt/live/www.googcci.com.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.googcci.com.cn/privkey.pem;

    client_max_body_size 20m;

    location = /revenue-costs {
        return 308 /revenue-costs/;
    }

    location ^~ /revenue-costs/api/ {
        client_max_body_size 64m;
        limit_req zone=revenue_costs_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:4282/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Prefix /revenue-costs;
        proxy_read_timeout 75s;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location ^~ /revenue-costs/health/ {
        proxy_pass http://127.0.0.1:4282/health/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Prefix /revenue-costs;
        access_log off;
    }

    location ^~ /revenue-costs/assets/ {
        alias /opt/revenue-costs/current/dist/web/assets/;
        expires 1y;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }

    location ^~ /revenue-costs/ {
        alias /opt/revenue-costs/current/dist/web/;
        index index.html;
        try_files $uri $uri/ /revenue-costs/index.html;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-OWI/hxKZxBEUbpj/MuebGIuKTPo9sNjDEBgpQ/njXXg='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
    }
}
